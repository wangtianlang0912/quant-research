# ============================================================
# quant_research_v2 · .gitignore
#
# ★ v1 事故根因，此处必须根治：
#   v1 的 `data/`（无前导斜杠）会被 Git 递归匹配任意层级的同名目录，
#   把 `src/data/` 整个包忽略掉 —— 导致 7 个模块 ModuleNotFoundError，
#   仓库 clone 下来跑不起来，而那个包从未被提交过，无人察觉。
#
# 铁律：
#   1. 目录型规则一律带前导斜杠（锚定仓库根），禁止裸目录名。
#   2. 运行时数据只有唯一一个根：`/var/`。
#   3. 源码树中不存在任何名为 `data` 的目录（由 tests/architecture 守卫）。
# ============================================================

# ---- Python 字节码 ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ---- 虚拟环境 ----
# 注意：`.venv/` 带前导点，不会误伤任何包；`env`/`venv` 不写成裸目录名
.venv/
.env

# ---- 分发 / 打包 ----
dist/
build/
*.egg-info/
*.egg
.eggs/

# ---- 测试与静态分析缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---- IDE / 编辑器 / OS ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- ★ 运行时数据根（唯一）—— 前导斜杠是刚需 ----
/var/

# ---- 二进制数据格式（var/ 之外的同名文件不应存在）----
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle

# ---- 日志 ----
*.log

# ---- 机密（凭证一律走环境变量，永不入库）----
configs/*.secret.yaml
configs/runtime.yaml
*.pem
*.key

# ---- 前端（T05 引入后再细化）----
web/node_modules/
web/dist/
